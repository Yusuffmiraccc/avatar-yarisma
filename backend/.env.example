APP_NAME=AVATAR API
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
# docker compose up -d mysql  ->  localhost:3307
DATABASE_URL=mysql+pymysql://avatar:change-me-local-only@localhost:3307/avatar_db?charset=utf8mb4
LOG_LEVEL=INFO
# Gerçek bir gizli değerle değiştirin; repoya koymayın.
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
WEIGHT_TOLERANCE_KG=0.000
ML_DIR=ml_artifacts
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-root-local-only
