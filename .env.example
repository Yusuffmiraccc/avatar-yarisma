# =============================================================================
# AVATAR Yarışması — Ortam Değişkenleri Şablonu (.env.example)
# Kullanım: Bu dosyayı '.env' olarak kopyalayın ve gerekli değerleri düzenleyin:
#   copy .env.example .env
# =============================================================================

ENVIRONMENT=local

# MySQL Veritabanı Yapılandırması
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-root-local-only

# Redis Önbellek ve Rate-Limit
REDIS_PASSWORD=avatar-test-only

# Güvenlik Anahtarları (Üretim ortamında güçlü rastgele anahtarlar kullanılmalıdır)
JWT_SECRET_KEY=local-dev-secret-change-me-0123456789abcdef
# Model dosya imzalama anahtarı; JWT_SECRET_KEY'den kesinlikle bağımsız olmalıdır
ML_SIGNING_SECRET=local-ml-signing-secret-0123456789abcdef

# Demo Kullanıcı ve Seed Ayarları
DEMO_PASSWORD=Avatar-Demo-2026!
ENABLE_DEMO_SEED=true

# Android Telefon ve LAN Bağlantı Ayarları
API_PORT=8000
WEB_PORT=5173
